{
  "expo": {
    "name": "Peon",
    "slug": "peon",
    "scheme": "peon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131317",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "no.stadler.peon",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "NSSpeechRecognitionUsageDescription": "Peon turns what you say into text for your sessions.",
        "NSMicrophoneUsageDescription": "Peon listens while you talk to it.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "no.stadler.peon",
      "adaptiveIcon": {
        "backgroundColor": "#131317",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Peon listens while you talk to it.",
          "speechRecognitionPermission": "Peon turns what you say into text for your sessions.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Peon attaches the images you pick to your messages.",
          "cameraPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93f24cab-d783-4954-9eda-583ac5fca992"
      }
    }
  }
}
