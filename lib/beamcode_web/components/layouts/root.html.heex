<!DOCTYPE html>
<html lang="en" class="bg-canvas">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Peon" suffix=" · Peon" phx-no-format>{assigns[:page_title]}</.live_title>
    <meta name="application-name" content="Peon" />
    <meta name="apple-mobile-web-app-title" content="Peon" />
    <meta name="theme-color" content="#121115" />
    <link rel="icon" type="image/png" href={~p"/favicon.ico"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-canvas text-fg">
    {@inner_content}
  </body>
</html>
